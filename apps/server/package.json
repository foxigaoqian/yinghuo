{
  "name": "@yinghuo/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && node dist/main.js",
    "dev:watch": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.cjs",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@yinghuo/contracts": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@prisma/client": "6.19.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "supertest": "7.1.4"
  }
}
