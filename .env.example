# LOCAL DEMO ONLY. Copy to .env; all real integrations intentionally blank.
NODE_ENV=development
APP_MODE=demo
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# Local demo JSON only; do not enter real family data.
DEMO_DATA_FILE=.data/demo.json
# Defaults to in-memory sessions; restarting API requires demo login again.
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=private-memories
REDIS_URL=
# Credentials are not consumed by mock providers. Filling them does NOT turn on live services.
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGNATURE=
SMS_TEMPLATE_ID=
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
PHOTO_PROVIDER=mock
PHOTO_API_URL=
PHOTO_API_KEY=
MODERATION_PROVIDER=mock
MODERATION_API_KEY=
PAYMENT_PROVIDER=mock
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set locally to view the development operations dashboard. No default password.
DEV_ADMIN_TOKEN=
SENTRY_DSN=

